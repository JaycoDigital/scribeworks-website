---
import Stars from './Stars.astro';

const reviews = [
  { quote: "Quoted, fitted and certified within two weeks. The finish around the new frames was spotless, and you'd never know the old ones had been there.", name: 'Jane H.', job: 'Windows & front door · Aldwick' },
  { quote: "They found rot in the sill that we didn't know about, showed us, gave us a price and carried on. No fuss and no inflated bill.", name: 'Mark & Sue T.', job: 'Bi-fold doors · Felpham' },
  { quote: "The tidiest team we've had. They swept up every evening and the skip was gone the day the job finished.", name: 'Dan P.', job: 'Garage conversion · Chichester' },
];
---

<section class="reviews">
  <div class="container inner">
    <div class="section-head section-head--dark" data-reveal-stagger>
      <h2>What our customers say</h2>
      <p>We're proud that so much of our work comes from recommendations by happy customers across Bognor Regis and the surrounding areas.</p>
    </div>

    <div class="grid" data-reveal-stagger>
      {
        reviews.map((r) => (
          <figure class="card">
            <div class="body">
              <Stars />
              <blockquote>“{r.quote}”</blockquote>
            </div>
            <figcaption>
              <div class="name">{r.name}</div>
              <div class="job">{r.job}</div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .reviews {
    background: var(--ink);
    color: var(--chalk);
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--sand-30);
  }

  .inner {
    position: relative;
    padding-block: var(--section-pad);
  }

  .inner :global(.section-head) {
    margin-bottom: 52px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .card {
    margin: 0;
    background: var(--ink-soft);
    border: 1px solid var(--chalk-14);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .body {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  blockquote {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--chalk);
  }

  figcaption {
    background: rgba(250, 249, 246, 0.07);
    border-top: 1px solid rgba(250, 249, 246, 0.12);
    padding: 20px 28px;
    font-size: 15px;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--chalk);
  }

  .job {
    color: rgba(250, 249, 246, 0.7);
    margin-top: 4px;
    font-size: 14px;
  }

</style>
