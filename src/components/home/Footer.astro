---
import { Image } from 'astro:assets';
import logoLight from '../../assets/logo-light.png';
import ArrowIcon from './ArrowIcon.astro';

const products = [
  { name: 'Windows', href: '/windows' },
  { name: 'Doors', href: '/doors' },
  { name: 'Cladding', href: '/cladding' },
  { name: 'Building works', href: '/building-works' },
];
const areas = ['Bognor Regis', 'Chichester', 'Littlehampton', 'Arundel', 'Worthing'];
---

<footer class="footer">
  <div class="container inner">
    <div class="top" id="contact" data-reveal-stagger>
      <h2>Let's get your project started</h2>
      <div class="contact">
        <a href="tel:01243000000" class="big">01243 000 000</a>
        <a href="mailto:info@scribeworks.co.uk" class="big">info@scribeworks.co.uk</a>
        <a href="tel:01243000000" class="btn btn--slate">Get a quote<ArrowIcon size={14} /></a>
      </div>
    </div>

    <div class="links" data-reveal-stagger>
      <div class="col">
        <h3>Products</h3>
        <ul>{products.map((p) => <li><a href={p.href}>{p.name}</a></li>)}</ul>
      </div>
      <div class="col">
        <h3>Areas covered</h3>
        <ul>{areas.map((a) => <li>{a}</li>)}</ul>
      </div>
      <div class="col">
        <h3>Accreditations</h3>
        <ul>
          <li>FENSA registered installer</li>
          <li>Checkatrade approved</li>
          <li>10-year workmanship guarantee</li>
        </ul>
      </div>
    </div>

    <div class="mark" data-reveal>
      <Image src={logoLight} alt="Scribeworks" widths={[800, 1350]} sizes="(max-width: 1400px) 100vw, 1304px" format="png" />
    </div>

  </div>
</footer>

<style>
  .footer {
    background: var(--ink-deep);
    color: rgba(250, 249, 246, 0.68);
    overflow: hidden;
  }

  .inner {
    padding-top: clamp(64px, 8vw, 110px);
  }

  /* Quote call-out */
  .top {
    scroll-margin-top: 30vh;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
    padding-bottom: clamp(48px, 6vw, 80px);
    border-bottom: 1px solid var(--chalk-14);
  }

  h2 {
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--chalk);
    max-width: 14ch;
    text-wrap: pretty;
  }

  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .big {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, 2.2vw, 28px);
    letter-spacing: -0.02em;
    color: var(--chalk);
    line-height: 1.2;
  }

  .big:hover {
    color: var(--sand);
  }

  .contact .btn {
    margin-top: 18px;
  }

  /* Link columns */
  .links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    padding: clamp(40px, 5vw, 64px) 0;
  }

  @media (max-width: 760px) {
    .links {
      grid-template-columns: 1fr;
    }
  }

  h3 {
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--chalk);
    margin-bottom: 18px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15px;
    line-height: 1.5;
  }

  .col a {
    color: rgba(250, 249, 246, 0.78);
  }

  .col a:hover {
    color: var(--chalk);
  }

  /* Full-width wordmark sitting on the page edge; the strapline below the
     baseline is cropped so the letters meet the bottom */
  .mark {
    margin-top: clamp(16px, 2vw, 32px);
    aspect-ratio: 1350 / 306;
    overflow: hidden;
  }

  .mark img {
    width: 100%;
    height: auto;
    display: block;
    /* Fades into the background so the wordmark reads as a watermark */
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0.5) 45%, rgba(0, 0, 0, 0.12) 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0.5) 45%, rgba(0, 0, 0, 0.12) 78%, transparent 100%);
  }

</style>
