---
import { Image } from 'astro:assets';
import logoLight from '../../assets/logo-light.png';
import ArrowIcon from './ArrowIcon.astro';

const products = ['Windows', 'Doors', 'Cladding', 'Building works'];
---

<header class="site-header">
  <div class="container bar">
    <a href="/home" class="logo" aria-label="Scribeworks home">
      <Image src={logoLight} alt="Scribeworks" height={40} densities={[1, 2]} loading="eager" />
    </a>

    <nav class="nav" aria-label="Main">
      {products.map((p) => <a href="#products">{p}</a>)}
    </nav>

    <a href="#contact" class="btn btn--slate btn--sm cta">Get a quote<ArrowIcon size={13} /></a>

    <button class="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu" data-menu-toggle>
      <span></span><span></span>
    </button>
  </div>
</header>

<!-- Full-screen menu for small screens -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>

  <nav class="mm-links" aria-label="Main">
    {
      products.map((p, i) => (
        <a href="#products" style={`--i: ${i}`}>
          <span class="mm-num">0{i + 1}</span>
          {p}
          <ArrowIcon size={22} class="mm-arrow" />
        </a>
      ))
    }
  </nav>

  <div class="mm-foot" style={`--i: ${products.length}`}>
    <a href="#contact" class="btn btn--slate">Get a quote<ArrowIcon size={14} /></a>
    <div class="mm-contact">
      <a href="tel:01243000000">01243 000 000</a>
      <a href="mailto:info@scribeworks.co.uk">info@scribeworks.co.uk</a>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: relative;
    z-index: 30;
    border-bottom: 1px solid var(--chalk-16);
  }

  /* While the menu is open the header sits above it, so logo and button stay exactly where they were */
  .site-header.menu-open {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
  }

  .bar {
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(12px, 2vw, 28px);
  }

  .logo img {
    height: 40px;
    width: auto;
    display: block;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.8vw, 30px);
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
  }

  .nav a {
    color: var(--chalk);
    white-space: nowrap;
  }

  .nav a:hover {
    color: var(--sand);
  }

  /* Menu button: subtle square with a + inside, a nod to a window pane */
  .menu-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--chalk-16);
    cursor: pointer;
  }

  .menu-toggle span {
    position: absolute;
    background: var(--chalk);
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu-open .menu-toggle span {
    transform: rotate(45deg);
  }

  .menu-toggle span:first-child {
    left: 12px;
    right: 12px;
    top: 50%;
    height: 1.5px;
    margin-top: -0.75px;
  }

  .menu-toggle span:last-child {
    top: 12px;
    bottom: 12px;
    left: 50%;
    width: 1.5px;
    margin-left: -0.75px;
  }

  /* Modal menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--ink-deep);
    color: var(--chalk);
    display: flex;
    flex-direction: column;
    padding: 84px var(--gutter) max(24px, env(safe-area-inset-bottom));
    opacity: 0;
    transform-origin: right center;
    transform: perspective(1400px) rotateY(-70deg);
    transition:
      opacity 360ms ease-out,
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Author display beats the UA [hidden] rule, so restate it */
  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu.is-open {
    opacity: 1;
    transform: none;
  }


  .menu-toggle:focus-visible {
    outline: 2px solid var(--sand);
    outline-offset: 3px;
  }


  .mm-links {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 24px 0;
  }

  .mm-links a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--chalk-14);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 8.5vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--chalk);
  }

  .mm-links a:active {
    color: var(--sand);
  }

  .mm-num {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--sand);
    flex: none;
    width: 28px;
  }

  .mm-links :global(.mm-arrow) {
    margin-left: auto;
    color: var(--sand);
    align-self: center;
  }

  .mm-foot {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-top: 8px;
  }

  .mm-foot .btn {
    justify-content: center;
  }

  .mm-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
  }

  .mm-contact a {
    color: rgba(250, 249, 246, 0.78);
  }

  /* Staggered entrance for the links and footer */
  .mm-links a,
  .mm-foot {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(80ms + var(--i, 0) * 60ms);
  }

  .mobile-menu.is-open .mm-links a,
  .mobile-menu.is-open .mm-foot {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 960px) {
    .menu-toggle {
      display: flex;
    }

    .nav,
    .cta {
      display: none;
    }
  }

  @media (min-width: 961px) {
    .mobile-menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mm-links a,
    .mm-foot {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  if (header && menu && btn) {
    let closing = 0;

    const open = () => {
      clearTimeout(closing);
      menu.hidden = false;
      header.classList.add('menu-open');
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Close menu');
      requestAnimationFrame(() => menu.classList.add('is-open'));
    };

    const close = () => {
      menu.classList.remove('is-open');
      header.classList.remove('menu-open');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Open menu');
      closing = window.setTimeout(() => { menu.hidden = true; }, 540);
    };

    btn.addEventListener('click', () => (menu.hidden || !menu.classList.contains('is-open') ? open() : close()));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) close(); });
  }
</script>
