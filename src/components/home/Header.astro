---
import { Image } from 'astro:assets';
import logoLight from '../../assets/logo-light.png';
import ArrowIcon from './ArrowIcon.astro';

const products = ['Windows', 'Doors', 'Cladding', 'Building works'];
---

<header class="site-header">
  <div class="container bar">
    <a href="/home" class="logo" aria-label="Scribeworks home">
      <Image src={logoLight} alt="Scribeworks" height={40} densities={[1, 2]} loading="eager" />
    </a>

    <nav class="nav" aria-label="Main">
      {products.map((p) => <a href="#products">{p}</a>)}
    </nav>

    <a href="#contact" class="btn btn--slate btn--sm cta">Get a quote<ArrowIcon size={13} /></a>

    <button class="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<!-- Full-screen menu for small screens -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="mm-top">
    <Image src={logoLight} alt="Scribeworks" height={36} densities={[1, 2]} />
    <button class="mm-close" type="button" aria-label="Close menu">
      <span></span><span></span>
    </button>
  </div>

  <nav class="mm-links" aria-label="Main">
    {
      products.map((p, i) => (
        <a href="#products" style={`--i: ${i}`}>
          <span class="mm-num">0{i + 1}</span>
          {p}
          <ArrowIcon size={22} class="mm-arrow" />
        </a>
      ))
    }
  </nav>

  <div class="mm-foot" style={`--i: ${products.length}`}>
    <a href="#contact" class="btn btn--slate">Get a quote<ArrowIcon size={14} /></a>
    <div class="mm-contact">
      <a href="tel:01243000000">01243 000 000</a>
      <a href="mailto:info@scribeworks.co.uk">info@scribeworks.co.uk</a>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: relative;
    z-index: 30;
    border-bottom: 1px solid var(--chalk-16);
  }

  .bar {
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(12px, 2vw, 28px);
  }

  .logo img {
    height: 40px;
    width: auto;
    display: block;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.8vw, 30px);
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
  }

  .nav a {
    color: var(--chalk);
    white-space: nowrap;
  }

  .nav a:hover {
    color: var(--sand);
  }

  /* Menu button drawn as a four-pane window: square frame with a cross */
  .menu-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 1.5px solid var(--chalk);
    cursor: pointer;
  }

  .menu-toggle span {
    position: absolute;
    background: var(--chalk);
  }

  .menu-toggle span:first-child {
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    margin-top: -0.75px;
  }

  .menu-toggle span:last-child {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1.5px;
    margin-left: -0.75px;
  }

  /* Modal menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--ink-deep);
    color: var(--chalk);
    display: flex;
    flex-direction: column;
    padding: 0 var(--gutter) max(24px, env(safe-area-inset-bottom));
    opacity: 0;
    transition: opacity 260ms ease-out;
  }

  .mobile-menu.is-open {
    opacity: 1;
  }

  .mm-top {
    height: 84px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--chalk-16);
  }

  .mm-top img {
    height: 36px;
    width: auto;
  }

  .mm-close {
    position: relative;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1.5px solid var(--chalk);
    cursor: pointer;
  }

  .mm-close span {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 50%;
    height: 1.5px;
    margin-top: -0.75px;
    background: var(--chalk);
  }

  .menu-toggle:focus-visible,
  .mm-close:focus-visible {
    outline: 2px solid var(--sand);
    outline-offset: 3px;
  }

  .mm-close span:first-child {
    transform: rotate(45deg);
  }

  .mm-close span:last-child {
    transform: rotate(-45deg);
  }

  .mm-links {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 24px 0;
  }

  .mm-links a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--chalk-14);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 8.5vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--chalk);
  }

  .mm-links a:active {
    color: var(--sand);
  }

  .mm-num {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--sand);
    flex: none;
    width: 28px;
  }

  .mm-links :global(.mm-arrow) {
    margin-left: auto;
    color: var(--sand);
    align-self: center;
  }

  .mm-foot {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-top: 8px;
  }

  .mm-foot .btn {
    justify-content: center;
  }

  .mm-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
  }

  .mm-contact a {
    color: rgba(250, 249, 246, 0.78);
  }

  /* Staggered entrance for the links and footer */
  .mm-links a,
  .mm-foot {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(80ms + var(--i, 0) * 60ms);
  }

  .mobile-menu.is-open .mm-links a,
  .mobile-menu.is-open .mm-foot {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 960px) {
    .menu-toggle {
      display: flex;
    }

    .nav,
    .cta {
      display: none;
    }
  }

  @media (min-width: 961px) {
    .mobile-menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mm-links a,
    .mm-foot {
      transition: none;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  const openBtn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const closeBtn = menu?.querySelector<HTMLButtonElement>('.mm-close');

  if (menu && openBtn && closeBtn) {
    const open = () => {
      menu.hidden = false;
      document.body.style.overflow = 'hidden';
      openBtn.setAttribute('aria-expanded', 'true');
      // Next frame so the fade transition runs
      requestAnimationFrame(() => menu.classList.add('is-open'));
      closeBtn.focus();
    };

    const close = () => {
      menu.classList.remove('is-open');
      document.body.style.overflow = '';
      openBtn.setAttribute('aria-expanded', 'false');
      const done = () => {
        menu.hidden = true;
        menu.removeEventListener('transitionend', done);
      };
      menu.addEventListener('transitionend', done);
      // Fallback if no transition fires (reduced motion)
      setTimeout(() => { if (!menu.classList.contains('is-open')) menu.hidden = true; }, 320);
      openBtn.focus();
    };

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) close(); });
  }
</script>
