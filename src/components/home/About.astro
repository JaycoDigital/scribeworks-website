---
import { Image } from 'astro:assets';
import ArrowIcon from './ArrowIcon.astro';
import Icon from './Icon.astro';
import fitter from '../../assets/about-fitter.jpg';
import exterior from '../../assets/about-exterior.jpg';

const checks = [
  'Free survey and a written fixed price within three working days',
  'FENSA certification, building regulations and waste removal all taken care of',
  'Timber, aluminium or uPVC, with honest advice on what suits your property',
];
---

<section id="about" class="about">
  <div class="container grid">
    <div class="photos" data-reveal-stagger>
      <Image src={exterior} alt="Modern extension with a full-height window overlooking a gravel garden" class="photo-a" widths={[600, 900, 1400]} sizes="(max-width: 760px) 100vw, 600px" format="webp" quality={80} />
      <Image src={fitter} alt="Scribeworks fitter adjusting a window handle" class="photo-b" widths={[400, 800]} sizes="(max-width: 760px) 50vw, 320px" format="webp" quality={80} />
    </div>

    <div class="copy" data-reveal-stagger>
      <h2>Over <span class="gold">10 years</span> of high quality windows and doors</h2>
      <p>Our team in Bognor Regis handles every job from start to finish. The same people survey and fit your windows and doors, so you always know who's looking after your home, and every installation is backed by our 10-year guarantee.</p>
      <ul class="checks">
        {
          checks.map((c) => (
            <li>
              <Icon name="check" size={22} stroke="var(--sand-deep)" />
              <span>{c}</span>
            </li>
          ))
        }
      </ul>
      <div class="cta">
        <a href="#contact" class="btn btn--slate">Get a quote<ArrowIcon size={14} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--chalk);
  }

  .grid {
    padding-block: var(--section-pad) clamp(24px, 3vw, 40px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }

  .photos {
    position: relative;
    padding-bottom: 40px;
    padding-right: clamp(0px, 6vw, 64px);
  }

  .photos :global(.photo-a) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  .photos :global(.photo-b) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 52%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: 60% 50%;
    border: 8px solid var(--chalk);
  }


  .copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
    border-left: 1px solid var(--line);
    padding-left: clamp(20px, 3vw, 44px);
  }

  h2 {
    font-size: clamp(34px, 4.2vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 22ch;
    text-wrap: pretty;
  }

  .gold {
    color: var(--sand-deep);
  }

  .copy > p {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 50ch;
  }

  .checks {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .checks li {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    font-size: 16px;
    line-height: 1.6;
  }

  .checks :global(svg) {
    flex: none;
    margin-top: 2px;
  }

  .cta {
    margin-top: 12px;
  }
</style>
