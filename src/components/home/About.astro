---
import ImageSlot from './ImageSlot.astro';
import ArrowIcon from './ArrowIcon.astro';

const checks = [
  'Free survey and a written fixed price in three working days',
  'Building regs, FENSA certification and waste removal handled',
  "Timber, aluminium or uPVC — we'll say what suits the house",
];
---

<section id="about" class="about">
  <div class="container grid">
    <div class="photos">
      <ImageSlot label="Finished room, windows in" tone="light" class="photo-a" />
      <ImageSlot label="Detail — sash or reveal" tone="light" class="photo-b" />
    </div>

    <div class="copy">
      <h2>Over <span class="gold">10 years</span> of high quality windows and doors</h2>
      <p>Our team in Bognor Regis handles every job from start to finish. The same people survey and fit your windows and doors, so you always know who's looking after your home, and every installation is backed by our 10-year guarantee.</p>
      <ul class="checks">
        {
          checks.map((c) => (
            <li>
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--sand-deep)" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                <path d="M4 12.5l5 5L20 6.5" />
              </svg>
              <span>{c}</span>
            </li>
          ))
        }
      </ul>
      <div class="cta">
        <a href="#contact" class="btn btn--slate">Get a quote<ArrowIcon size={14} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--chalk);
  }

  .grid {
    padding-block: var(--section-pad) clamp(24px, 3vw, 40px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }

  .photos {
    position: relative;
    padding-bottom: 40px;
    padding-right: clamp(0px, 6vw, 64px);
  }

  .photos :global(.photo-a) {
    width: 100%;
    aspect-ratio: 4 / 5;
    display: flex;
  }

  .photos :global(.photo-b) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 52%;
    aspect-ratio: 1 / 1;
    border: 8px solid var(--chalk);
  }


  .copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
    border-left: 1px solid var(--line);
    padding-left: clamp(20px, 3vw, 44px);
  }

  h2 {
    font-size: clamp(28px, 3.9vw, 46px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 22ch;
    text-wrap: pretty;
  }

  .gold {
    color: var(--sand-deep);
  }

  .copy > p {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 50ch;
  }

  .checks {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .checks li {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    font-size: 16px;
    line-height: 1.6;
  }

  .checks svg {
    flex: none;
    margin-top: 3px;
  }

  .cta {
    margin-top: 12px;
  }
</style>
