---
import { Image } from 'astro:assets';
import ArrowIcon from './ArrowIcon.astro';
import windows from '../../assets/product-windows.jpg';
import doors from '../../assets/product-doors.jpg';
import cladding from '../../assets/product-cladding.jpg';
import building from '../../assets/product-building.jpg';

const products = [
  { href: '/windows', title: 'Windows', body: 'uPVC, aluminium and timber. Casement, sash, tilt-and-turn or shaped heads to match the house.', photo: windows, alt: 'New windows fitted to a house' },
  { href: '/doors', title: 'Doors', body: 'Front doors, French, bi-fold and sliding patio sets. Multipoint locking as standard.', photo: doors, alt: 'A newly fitted front door' },
  { href: '/cladding', title: 'Cladding', body: 'Cedar, composite and fibre cement weatherboard on a drained, ventilated batten system.', photo: cladding, alt: 'Timber cladding on a modern extension' },
  { href: '/building-works', title: 'Building works', body: 'Extensions, garage conversions, knock-throughs and structural openings, from drawings to decorating.', photo: building, alt: 'Building works in progress' },
];
---

<section id="products" class="products">
  <div class="container inner">
    <div class="section-head" data-reveal-stagger>
      <h2>Made to measure, made to last</h2>
      <p>Whether you're after a simple upgrade or a complete transformation, we offer a wide range of styles, materials and finishes to suit every home and budget.</p>
    </div>

    <div class="grid" data-reveal-stagger>
      {
        products.map((p) => (
          <a href={p.href} class="card">
            <Image src={p.photo} alt={p.alt} class="photo" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 620px" format="webp" quality={78} />
            <div class="photo-scrim" />
            <div class="text">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              <span class="more eyebrow">View range<ArrowIcon size={13} /></span>
            </div>
          </a>
        ))
      }
    </div>

  </div>
</section>

<style>
  /* White behind the cards, easing into Chalk so the next section joins seamlessly */
  .products {
    background: linear-gradient(to bottom, var(--white) 0%, var(--white) 72%, var(--chalk) 100%);
  }

  .inner {
    padding-block: var(--section-pad);
  }

  /* Two-up grid of large cards; stacks to one column on phones */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 24px;
  }

  .card {
    position: relative;
    min-height: clamp(400px, 36vw, 480px);
    background: var(--ink);
    overflow: hidden;
    display: block;
    color: var(--white);
  }

  .card:hover {
    color: var(--white);
  }

  .card :global(.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms ease-out;
  }

  .card:hover :global(.photo) {
    transform: scale(1.03);
  }

  .photo-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(29, 29, 29, 0.95) 0%, rgba(29, 29, 29, 0.72) 42%, rgba(29, 29, 29, 0.25) 74%, rgba(29, 29, 29, 0.12) 100%);
  }

  .text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: clamp(28px, 3.2vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    pointer-events: none;
  }

  h3 {
    font-size: clamp(24px, 2.3vw, 30px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .text p {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.86);
    max-width: 44ch;
  }

  .more {
    border-top: 1px solid rgba(250, 249, 246, 0.3);
    margin-top: 10px;
    padding-top: 18px;
    color: var(--sand);
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

</style>
