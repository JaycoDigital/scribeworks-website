---
import ImageSlot from './ImageSlot.astro';
import ArrowIcon from './ArrowIcon.astro';

const products = [
  { title: 'Windows', body: 'uPVC, aluminium and timber. Casement, sash, tilt-and-turn or shaped heads to match the house.', photo: 'Window photo' },
  { title: 'Doors', body: 'Front doors, French, bi-fold and sliding patio sets. Multipoint locking as standard.', photo: 'Door photo — front or bi-fold' },
  { title: 'Cladding', body: 'Cedar, composite and fibre cement weatherboard on a drained, ventilated batten system.', photo: 'Cladding photo' },
  { title: 'Building works', body: 'Extensions, garage conversions, knock-throughs and structural openings — drawings to decorating.', photo: 'Building works photo' },
];
---

<section id="products" class="products">
  <div class="container inner">
    <div class="section-head">
      <h2>Made to measure, made to last</h2>
      <p>Whether you're after a simple upgrade or a complete transformation, we offer a wide range of styles, materials and finishes to suit every home and budget.</p>
    </div>

    <div class="grid">
      {
        products.map((p) => (
          <a href="#products" class="card">
            <ImageSlot label={p.photo} class="photo" />
            <div class="photo-scrim" />
            <div class="text">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              <span class="more eyebrow">View range<ArrowIcon size={13} /></span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="strip">
      <div class="strip-copy">
        <span class="tag">Free</span>
        <span>Survey, measure and a fixed written price — no deposit to book.</span>
      </div>
      <a href="#contact" class="link-rule strip-link">Request a quote</a>
    </div>
  </div>
</section>

<style>
  .products {
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .inner {
    padding-block: var(--section-pad);
  }

  /* Two-up grid of large cards; stacks to one column on phones */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 24px;
  }

  .card {
    position: relative;
    min-height: clamp(400px, 36vw, 480px);
    background: var(--ink);
    overflow: hidden;
    display: block;
    color: var(--white);
  }

  .card:hover {
    color: var(--white);
  }

  .card :global(.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: transform 600ms ease-out;
  }

  .card:hover :global(.photo) {
    transform: scale(1.03);
  }

  .photo-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(29, 29, 29, 0.94) 0%, rgba(29, 29, 29, 0.6) 42%, rgba(29, 29, 29, 0.1) 74%, rgba(29, 29, 29, 0.1) 100%);
  }

  .text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: clamp(28px, 3.2vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    pointer-events: none;
  }

  h3 {
    font-size: clamp(24px, 2.3vw, 30px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .text p {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.86);
    max-width: 44ch;
  }

  .more {
    border-top: 1px solid rgba(250, 249, 246, 0.3);
    margin-top: 10px;
    padding-top: 18px;
    color: var(--sand);
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  .strip {
    margin-top: 36px;
    background: var(--ink);
    color: var(--chalk);
    padding: 22px 26px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    justify-content: space-between;
  }

  .strip-copy {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 16px;
    line-height: 1.6;
  }

  .tag {
    background: var(--sand);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 8px 12px;
  }

  .strip-link {
    color: var(--slate-pale);
  }

  .strip-link:hover {
    color: var(--white);
  }
</style>
