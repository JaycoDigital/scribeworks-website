---
/**
 * Full-screen film that scrubs with the scroll wheel: while it fills the
 * viewport the page holds still and scrolling moves the clip, releasing at
 * either end. Falls back to a plain looping video for reduced-motion users.
 */
---

<section id="film" class="film">
  <div class="frame">
    <video src="/media/fit-out.mp4" muted playsinline preload="auto" loop aria-label="Time-lapse of a Scribeworks window fit-out"></video>
    <div class="track" aria-hidden="true"><div class="bar"></div></div>
  </div>
</section>

<style>
  .film {
    position: relative;
    height: 100vh;
    height: 100svh;
    background: var(--ink-deep);
    border-top: 1px solid var(--sand-30);
    isolation: isolate;
  }

  .frame {
    position: relative;
    height: 100%;
    width: 100%;
    overflow: hidden;
    background: var(--ink-deep);
  }

  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .track {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 160px;
    background: rgba(250, 249, 246, 0.25);
    pointer-events: none;
  }

  .bar {
    width: 3px;
    margin-left: -1px;
    height: 0;
    background: var(--sand);
  }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('#film');
  const video = wrap?.querySelector<HTMLVideoElement>('video');
  const bar = wrap?.querySelector<HTMLElement>('.bar');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (wrap && video && bar) {
    if (reduceMotion) {
      // Just let it play; no scroll hijacking
      video.play().catch(() => {});
    } else {
      let p = 0;
      let locked = false;
      let lastY: number | null = null;

      const apply = () => {
        bar.style.height = `${p * 100}%`;
        if (video.duration && isFinite(video.duration)) {
          const t = p * video.duration;
          if (Math.abs(video.currentTime - t) > 0.02) video.currentTime = t;
        }
      };

      // Returns true when the scroll was consumed by the film
      const advance = (delta: number) => {
        const r = wrap.getBoundingClientRect();
        const mid = window.innerHeight * 0.5;
        if (r.top > mid || r.bottom < mid) {
          locked = false;
          return false;
        }
        if ((delta > 0 && p >= 1) || (delta < 0 && p <= 0)) {
          locked = false;
          return false;
        }
        if (!locked) {
          locked = true;
          p = delta > 0 ? 0 : 1;
        }
        p = Math.min(1, Math.max(0, p + delta / 1600));
        apply();
        window.scrollTo(0, wrap.offsetTop);
        return true;
      };

      window.addEventListener('wheel', (e) => { if (advance(e.deltaY)) e.preventDefault(); }, { passive: false });
      window.addEventListener('touchstart', (e) => { lastY = e.touches[0].clientY; }, { passive: true });
      window.addEventListener(
        'touchmove',
        (e) => {
          const y = e.touches[0].clientY;
          const d = (lastY == null ? y : lastY) - y;
          lastY = y;
          if (advance(d * 2.2)) e.preventDefault();
        },
        { passive: false },
      );
      window.addEventListener('keydown', (e) => {
        const map: Record<string, number> = { ArrowDown: 120, PageDown: 400, ArrowUp: -120, PageUp: -400 };
        if (map[e.key] && advance(map[e.key])) e.preventDefault();
      });

      video.pause();
      video.removeAttribute('loop');
      video.addEventListener('loadedmetadata', apply);
      apply();
    }
  }
</script>
