---
/**
 * Full-screen film that scrubs with the scroll wheel: while it fills the
 * viewport the page holds still and scrolling moves the clip, releasing at
 * either end. Falls back to a plain looping video for reduced-motion users.
 */
---

<section id="film" class="film">
  <div class="frame">
    <video src="/media/fit-out-scrub.mp4" muted playsinline preload="auto" loop aria-label="Time-lapse of a Scribeworks window fit-out"></video>
    <div class="track" aria-hidden="true"><div class="bar"></div></div>
  </div>
</section>

<style>
  .film {
    position: relative;
    height: 100vh;
    height: 100svh;
    background: var(--ink-deep);
    isolation: isolate;
  }

  /* Soft edges: fade the neighbouring section colours into the film */
  .frame::before,
  .frame::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: clamp(120px, 18vh, 220px);
    pointer-events: none;
    z-index: 1;
  }

  .frame::before {
    top: 0;
    background: linear-gradient(to bottom, var(--chalk) 0%, rgba(250, 249, 246, 0.6) 35%, rgba(250, 249, 246, 0) 100%);
  }

  .frame::after {
    bottom: 0;
    background: linear-gradient(to top, var(--white) 0%, rgba(255, 255, 255, 0.6) 35%, rgba(255, 255, 255, 0) 100%);
  }

  .frame {
    position: relative;
    height: 100%;
    width: 100%;
    overflow: hidden;
    background: var(--ink-deep);
  }

  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .track {
    z-index: 2;
    position: absolute;
    left: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 160px;
    background: rgba(250, 249, 246, 0.25);
    pointer-events: none;
  }

  .bar {
    width: 3px;
    margin-left: -1px;
    height: 0;
    background: var(--sand);
  }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('#film');
  const video = wrap?.querySelector<HTMLVideoElement>('video');
  const bar = wrap?.querySelector<HTMLElement>('.bar');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (wrap && video && bar) {
    if (reduceMotion) {
      // Just let it play; no scroll hijacking
      video.play().catch(() => {});
    } else {
      // Share of the clip that plays while the section slides into view (from
      // 50% up the screen to the top), and the share that plays as it scrolls
      // away again. Everything between scrubs while pinned.
      const LEAD = 0.25;
      const TAIL = 0.2;
      const APPROACH = 0.5;
      const SCROLL_PER_CLIP = 2400; // px of wheel travel for the pinned part
      const PIN_END = 1 - TAIL;

      // Scroll progress → clip time, as a fraction of duration. The clip's
      // sketch-to-colour change happens in about a second and the last third
      // is a still frame, so stretch the transition and compress the tail.
      //            progress, time
      const CURVE: [number, number][] = [
        [0, 0],
        [0.4, 0.49], // sketch builds up
        [0.8, 0.68], // colour arrives (stretched, finishes as the pin releases)
        [1, 1], // settled house
      ];
      const timeAt = (p: number) => {
        for (let i = 1; i < CURVE.length; i++) {
          const [p0, t0] = CURVE[i - 1];
          const [p1, t1] = CURVE[i];
          if (p <= p1) return t0 + ((p - p0) / (p1 - p0)) * (t1 - t0);
        }
        return 1;
      };

      let target = 0; // where the scroll input says we should be (0–1)
      let shown = 0; // where the video actually is; eased toward target each frame
      let locked = false;
      let lastY: number | null = null;
      let raf = 0;
      let seeking = false;

      const setFrame = (p: number) => {
        bar.style.height = `${p * 100}%`;
        if (!video.duration || !isFinite(video.duration)) return;
        if (seeking) return; // one seek in flight at a time
        const t = timeAt(p) * video.duration;
        if (Math.abs(video.currentTime - t) > 0.01) {
          seeking = true;
          video.currentTime = t;
        }
      };
      video.addEventListener('seeked', () => { seeking = false; });

      // Ease the displayed position toward the target so bursts of wheel
      // events become one continuous movement
      const tick = () => {
        const diff = target - shown;
        if (Math.abs(diff) < 0.0005) {
          shown = target;
          setFrame(shown);
          raf = 0;
          return;
        }
        shown += diff * 0.14;
        setFrame(shown);
        raf = requestAnimationFrame(tick);
      };
      const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };

      // Unpinned phases: while the page scrolls normally, map the section's
      // position on screen to the first LEAD (coming in) or last TAIL (going
      // out) of the clip
      const onScroll = () => {
        if (locked) return;
        const top = wrap.getBoundingClientRect().top;
        const zone = window.innerHeight * APPROACH;
        if (top < 0) {
          target = PIN_END + Math.min(1, -top / zone) * TAIL;
        } else {
          target = Math.min(1, Math.max(0, (zone - top) / zone)) * LEAD;
        }
        kick();
      };

      // Where the page is heading (the smooth scroller's target if present)
      const pageY = () => window.__scroll?.target ?? window.scrollY;
      const pin = () => {
        if (window.__scroll) window.__scroll.pinTo(wrap.offsetTop);
        else window.scrollTo(0, wrap.offsetTop);
      };

      // Pinned phase. Returns true when the scroll was consumed by the film.
      const advance = (delta: number) => {
        const top = wrap.offsetTop - pageY();
        if (!locked) {
          // Engage the moment the section is about to cross the top edge
          const crossingDown = delta > 0 && top > 0 && top <= delta;
          const crossingUp = delta < 0 && top < 0 && top >= delta;
          if (!crossingDown && !crossingUp) return false;
          locked = true;
          pin();
        }
        target = Math.min(PIN_END, Math.max(LEAD, target + delta / SCROLL_PER_CLIP));
        kick();
        // Release at either end so the page carries on
        if ((delta > 0 && target >= PIN_END) || (delta < 0 && target <= LEAD)) {
          locked = false;
          return false;
        }
        pin();
        return true;
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.__filmAdvance = advance;
      // Without the smooth scroller (touch devices, reduced motion) handle the wheel here
      window.addEventListener('wheel', (e) => {
        if (window.__scroll) return;
        if (advance(e.deltaY)) e.preventDefault();
      }, { passive: false });
      window.addEventListener('touchstart', (e) => { lastY = e.touches[0].clientY; }, { passive: true });
      window.addEventListener(
        'touchmove',
        (e) => {
          const y = e.touches[0].clientY;
          const d = (lastY == null ? y : lastY) - y;
          lastY = y;
          if (advance(d * 2.2)) e.preventDefault();
        },
        { passive: false },
      );
      window.addEventListener('keydown', (e) => {
        const map: Record<string, number> = { ArrowDown: 160, PageDown: 600, ArrowUp: -160, PageUp: -600 };
        if (map[e.key] && advance(map[e.key])) e.preventDefault();
      });

      video.pause();
      video.removeAttribute('loop');
      video.addEventListener('loadedmetadata', onScroll);
      onScroll();
    }
  }
</script>
