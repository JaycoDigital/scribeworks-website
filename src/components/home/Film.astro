---
/**
 * Scroll-driven film. A tall section scrolls past while a sticky, full-screen
 * canvas stays in view; scroll progress through the section picks a frame
 * from a preloaded WebP sequence. Native scrolling is never intercepted.
 *
 * Frames come from scripts/extract-frames.sh (public/media/frames/{lg,sm}).
 */
const FRAMES = 217;
const POSTER = '/media/frames/lg/000.webp'; // matches the first canvas frame
const FALLBACK = '/media/frames/lg/216.webp'; // finished house, for reduced motion / no canvas
---

<section id="film" class="film" data-frames={FRAMES}>
  <div class="sticky">
    <canvas class="screen" aria-label="Time-lapse of a Scribeworks window fit-out, drawn as you scroll" role="img"></canvas>
    <img class="poster" src={POSTER} data-fallback={FALLBACK} alt="Finished house from the fit-out time-lapse" decoding="async" />
    <div class="track" aria-hidden="true"><div class="bar"></div></div>
  </div>
</section>

<style>
  /* Section height sets the scrub distance: 100vh of sticky frame plus the
     travel while it stays pinned */
  .film {
    --travel: 200vh;
    position: relative;
    height: calc(100vh + var(--travel));
    height: calc(100svh + var(--travel));
    background: var(--ink-deep);
  }

  @media (max-width: 760px) {
    .film {
      --travel: 150vh;
    }
  }

  .sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--ink-deep);
  }

  .screen,
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .poster {
    object-fit: cover;
  }

  /* Poster shows until the canvas has drawn its first frame */
  .film.is-ready .poster {
    display: none;
  }

  .film.is-fallback .screen {
    display: none;
  }

  /* Soft edges: fade the neighbouring section colours into the film */
  .sticky::before,
  .sticky::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: clamp(120px, 18vh, 220px);
    pointer-events: none;
    z-index: 1;
  }

  .sticky::before {
    top: 0;
    background: linear-gradient(to bottom, var(--chalk) 0%, rgba(250, 249, 246, 0.6) 35%, rgba(250, 249, 246, 0) 100%);
  }

  .sticky::after {
    bottom: 0;
    background: linear-gradient(to top, var(--white) 0%, rgba(255, 255, 255, 0.6) 35%, rgba(255, 255, 255, 0) 100%);
  }

  .track {
    z-index: 2;
    position: absolute;
    left: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 160px;
    background: rgba(250, 249, 246, 0.25);
    pointer-events: none;
  }

  .bar {
    width: 3px;
    margin-left: -1px;
    height: 0;
    background: var(--sand);
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#film');
  const canvas = section?.querySelector<HTMLCanvasElement>('.screen');
  const bar = section?.querySelector<HTMLElement>('.bar');
  const ctx = canvas?.getContext('2d', { alpha: false });
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && canvas && bar && ctx && !reduceMotion) {
    const COUNT = Number(section.dataset.frames);
    const set = window.innerWidth <= 760 ? 'sm' : 'lg';
    const src = (i: number) => `/media/frames/${set}/${String(i).padStart(3, '0')}.webp`;

    // Scroll progress → frame. The sketch builds for the first half of the
    // clip and turns to colour in about a second, so give that moment more
    // scroll and the slow settle at the end less.
    //             progress, frame (as fraction of COUNT-1)
    const CURVE: [number, number][] = [
      [0, 0],
      [0.4, 0.49],
      [0.8, 0.66],
      [1, 1],
    ];
    const frameAt = (p: number) => {
      for (let i = 1; i < CURVE.length; i++) {
        const [p0, f0] = CURVE[i - 1];
        const [p1, f1] = CURVE[i];
        if (p <= p1) return (f0 + ((p - p0) / (p1 - p0)) * (f1 - f0)) * (COUNT - 1);
      }
      return COUNT - 1;
    };

    // ---- Frame loading: first frame, then a coarse spread, then fill in ----
    const frames: (HTMLImageElement | null)[] = new Array(COUNT).fill(null);
    const order: number[] = [0, COUNT - 1];
    for (const step of [16, 8, 4, 2, 1]) {
      for (let i = 0; i < COUNT; i += step) if (!order.includes(i)) order.push(i);
    }
    let loading = false;
    const loadAll = () => {
      if (loading) return;
      loading = true;
      let idx = 0;
      const PARALLEL = 6;
      const next = () => {
        if (idx >= order.length) return;
        const i = order[idx++];
        const img = new Image();
        img.decoding = 'async';
        img.onload = () => {
          frames[i] = img;
          if (i === 0 || i === Math.round(shown)) needsDraw = true;
          kick();
          next();
        };
        img.onerror = () => next();
        img.src = src(i);
      };
      for (let k = 0; k < PARALLEL; k++) next();
    };

    // Nearest frame we actually have, searching outward from the wanted one
    const nearestLoaded = (i: number) => {
      if (frames[i]) return frames[i];
      for (let d = 1; d < COUNT; d++) {
        if (frames[i - d]) return frames[i - d];
        if (frames[i + d]) return frames[i + d];
      }
      return null;
    };

    // ---- Canvas sizing (device pixels, capped for performance) ----
    let cw = 0;
    let ch = 0;
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const r = canvas.getBoundingClientRect();
      cw = Math.round(r.width * dpr);
      ch = Math.round(r.height * dpr);
      canvas.width = cw;
      canvas.height = ch;
      needsDraw = true;
      kick();
    };

    // ---- Drawing ----
    let drawnFrame = -1;
    let needsDraw = false;
    const draw = (f: number) => {
      const img = nearestLoaded(f);
      if (!img) return;
      // object-fit: cover
      const scale = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const w = img.naturalWidth * scale;
      const h = img.naturalHeight * scale;
      ctx.drawImage(img, (cw - w) / 2, (ch - h) / 2, w, h);
      drawnFrame = f;
      if (!section.classList.contains('is-ready')) section.classList.add('is-ready');
    };

    // ---- Progress: 0 when the section top is halfway up the screen, 1 when
    // the sticky frame starts to leave ----
    const progress = () => {
      const r = section.getBoundingClientRect();
      const vh = window.innerHeight;
      const start = vh * 0.5; // begin while it's still sliding into view
      const end = -(r.height - vh); // section top when the sticky frame unpins
      return Math.min(1, Math.max(0, (start - r.top) / (start - end)));
    };

    // ---- Animation loop: ease the shown frame toward the target ----
    let target = 0;
    let shown = 0;
    let raf = 0;
    const tick = () => {
      raf = 0;
      const diff = target - shown;
      // Snap when close so we settle exactly; otherwise ease (faster when far behind)
      if (Math.abs(diff) < 0.05) shown = target;
      else shown += diff * (Math.abs(diff) > 12 ? 0.35 : 0.22);
      const f = Math.round(shown);
      if (f !== drawnFrame || needsDraw) {
        needsDraw = false;
        draw(f);
        bar.style.height = `${(shown / (COUNT - 1)) * 100}%`;
      }
      if (shown !== target) kick();
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };

    const onScroll = () => {
      target = frameAt(progress());
      kick();
    };

    // Start fetching frames a couple of screens before the section arrives
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          loadAll();
          io.disconnect();
        }
      },
      { rootMargin: '200% 0px' },
    );
    io.observe(section);

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', resize, { passive: true });
    resize();
    onScroll();
    // Draw the first frame immediately even if the section is far away
    if (progress() === 0) loadAll();
  } else if (section) {
    // Reduced motion or no canvas: show the finished house
    const poster = section.querySelector<HTMLImageElement>('.poster');
    if (poster?.dataset.fallback) poster.src = poster.dataset.fallback;
    section.classList.add('is-fallback');
  }
</script>
