---
/**
 * Full-screen film that scrubs with the scroll wheel: while it fills the
 * viewport the page holds still and scrolling moves the clip, releasing at
 * either end. Falls back to a plain looping video for reduced-motion users.
 */
---

<section id="film" class="film">
  <div class="frame">
    <video src="/media/fit-out-scrub.mp4" muted playsinline preload="auto" loop aria-label="Time-lapse of a Scribeworks window fit-out"></video>
    <div class="track" aria-hidden="true"><div class="bar"></div></div>
  </div>
</section>

<style>
  .film {
    position: relative;
    height: 100vh;
    height: 100svh;
    background: var(--ink-deep);
    isolation: isolate;
  }

  /* Soft edges: fade the neighbouring section colours into the film */
  .frame::before,
  .frame::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: clamp(120px, 18vh, 220px);
    pointer-events: none;
    z-index: 1;
  }

  .frame::before {
    top: 0;
    background: linear-gradient(to bottom, var(--chalk) 0%, rgba(250, 249, 246, 0.6) 35%, rgba(250, 249, 246, 0) 100%);
  }

  .frame::after {
    bottom: 0;
    background: linear-gradient(to top, var(--white) 0%, rgba(255, 255, 255, 0.6) 35%, rgba(255, 255, 255, 0) 100%);
  }

  .frame {
    position: relative;
    height: 100%;
    width: 100%;
    overflow: hidden;
    background: var(--ink-deep);
  }

  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .track {
    z-index: 2;
    position: absolute;
    left: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 160px;
    background: rgba(250, 249, 246, 0.25);
    pointer-events: none;
  }

  .bar {
    width: 3px;
    margin-left: -1px;
    height: 0;
    background: var(--sand);
  }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('#film');
  const video = wrap?.querySelector<HTMLVideoElement>('video');
  const bar = wrap?.querySelector<HTMLElement>('.bar');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (wrap && video && bar) {
    if (reduceMotion) {
      // Just let it play; no scroll hijacking
      video.play().catch(() => {});
    } else {
      // Share of the clip that plays while the section slides into view (from
      // 50% up the screen to the top), and the share that plays as it scrolls
      // away again. Everything between scrubs while pinned.
      const LEAD = 0.25;
      const TAIL = 0.2;
      const APPROACH = 0.5;
      const SCROLL_PER_CLIP = 2400; // px of wheel travel for the pinned part
      const PIN_END = 1 - TAIL;

      // Scroll progress → clip time, as a fraction of duration. The clip's
      // sketch-to-colour change happens in about a second and the last third
      // is a still frame, so stretch the transition and compress the tail.
      //            progress, time
      const CURVE: [number, number][] = [
        [0, 0],
        [0.4, 0.49], // sketch builds up
        [0.8, 0.68], // colour arrives (stretched, finishes as the pin releases)
        [1, 1], // settled house
      ];
      const timeAt = (p: number) => {
        for (let i = 1; i < CURVE.length; i++) {
          const [p0, t0] = CURVE[i - 1];
          const [p1, t1] = CURVE[i];
          if (p <= p1) return t0 + ((p - p0) / (p1 - p0)) * (t1 - t0);
        }
        return 1;
      };

      // Where we are relative to the section: approaching it, pinned on it,
      // or past it. Decided from real scroll position, not wheel deltas, so a
      // fast flick can't skip the lock.
      type Phase = 'above' | 'pinned' | 'below';
      let phase: Phase = 'above';
      let target = 0; // where the scroll input says we should be (0–1)
      let shown = 0; // where the video actually is; eased toward target each frame
      let lastY: number | null = null;
      let raf = 0;
      let seeking = false;

      const FRAME = 1 / 48; // half a frame at 24fps; smaller moves aren't worth a seek
      const setFrame = (p: number) => {
        bar.style.height = `${p * 100}%`;
        if (!video.duration || !isFinite(video.duration)) return;
        if (seeking) return; // one seek in flight at a time
        const t = timeAt(p) * video.duration;
        if (Math.abs(video.currentTime - t) > FRAME) {
          seeking = true;
          video.currentTime = t;
        }
      };
      video.addEventListener('seeked', () => {
        seeking = false;
        // Catch up if the target moved while we were seeking
        if (Math.abs(shown - target) > 0.0005) kick();
      });

      // Ease the displayed position toward the target so bursts of wheel
      // events become one continuous movement
      const tick = () => {
        const diff = target - shown;
        if (Math.abs(diff) < 0.0005) {
          shown = target;
          setFrame(shown);
          raf = 0;
          return;
        }
        shown += diff * 0.14;
        setFrame(shown);
        raf = requestAnimationFrame(tick);
      };
      const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };

      // Snap, never glide: the page uses scroll-behavior: smooth for anchors,
      // so switch it off for the duration of the jump
      const html = document.documentElement;
      const pin = () => {
        const prev = html.style.scrollBehavior;
        html.style.scrollBehavior = 'auto';
        window.scrollTo(0, wrap.offsetTop);
        html.style.scrollBehavior = prev;
      };

      const onScroll = () => {
        const top = wrap.getBoundingClientRect().top;

        if (phase === 'pinned') {
          // Hold position against momentum or anything else that moved the page
          if (Math.abs(top) > 0.5) pin();
          return;
        }

        const zone = window.innerHeight * APPROACH;
        const height = wrap.offsetHeight;
        if (phase === 'above') {
          if (top <= -height) {
            // Jumped clean past it (scroll restore, anchor link): skip the lock
            phase = 'below';
            target = 1;
          } else if (top <= 0) {
            // Crossed the top edge on the way down: lock on
            phase = 'pinned';
            target = Math.max(target, LEAD);
            pin();
          } else {
            target = Math.min(1, Math.max(0, (zone - top) / zone)) * LEAD;
          }
        } else {
          // below
          if (top >= window.innerHeight) {
            // Jumped clean back above it: skip the lock
            phase = 'above';
            target = 0;
          } else if (top >= 0) {
            // Came back up to the top edge: lock on and scrub backwards
            phase = 'pinned';
            target = Math.min(target, PIN_END);
            pin();
          } else {
            target = PIN_END + Math.min(1, -top / zone) * TAIL;
          }
        }
        kick();
      };

      // While pinned, wheel/touch/keys scrub the clip instead of scrolling.
      // Returns true when the input was consumed.
      const advance = (delta: number) => {
        if (phase !== 'pinned') return false;
        target = Math.min(PIN_END, Math.max(LEAD, target + delta / SCROLL_PER_CLIP));
        kick();
        if (delta > 0 && target >= PIN_END) {
          phase = 'below';
          return false; // let this scroll through so the page carries on
        }
        if (delta < 0 && target <= LEAD) {
          phase = 'above';
          return false;
        }
        return true;
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('wheel', (e) => { if (advance(e.deltaY)) e.preventDefault(); }, { passive: false });
      window.addEventListener('touchstart', (e) => { lastY = e.touches[0].clientY; }, { passive: true });
      window.addEventListener(
        'touchmove',
        (e) => {
          const y = e.touches[0].clientY;
          const d = (lastY == null ? y : lastY) - y;
          lastY = y;
          if (advance(d * 2.2)) e.preventDefault();
        },
        { passive: false },
      );
      window.addEventListener('keydown', (e) => {
        const map: Record<string, number> = { ArrowDown: 160, PageDown: 600, ArrowUp: -160, PageUp: -600 };
        if (map[e.key] && advance(map[e.key])) e.preventDefault();
      });

      // Work out the starting phase (page may load scrolled)
      if (wrap.getBoundingClientRect().top < 0) {
        phase = 'below';
        target = shown = 1;
      }

      video.pause();
      video.removeAttribute('loop');
      video.addEventListener('loadedmetadata', onScroll);
      onScroll();
    }
  }
</script>
