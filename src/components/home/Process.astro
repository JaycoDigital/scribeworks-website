---
import ImageSlot from './ImageSlot.astro';
import ArrowIcon from './ArrowIcon.astro';

const steps = [
  { n: '01', title: 'Free Survey', body: 'We visit your home to take measurements, check the space and talk you through the best options for your property.' },
  { n: '02', title: 'Your Fixed Quote', body: "Within three working days, you'll receive a clear written quote showing exactly what's included and when we can start." },
  { n: '03', title: 'Installation', body: 'Our team fits everything with care, leaves your home clean and tidy, and hands over all your certificates once the job is done.' },
];
---

<section id="process" class="process">
  <div class="container grid">
    <div class="copy">
      <h2>Your project in three simple steps</h2>
      <p>We keep things simple, so you'll know exactly what's happening at every stage.</p>
      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <span class="num">{s.n}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="cta">
        <a href="#contact" class="btn btn--slate">Get a quote<ArrowIcon size={14} /></a>
      </div>
    </div>
    <div class="photos">
      <ImageSlot label="Wide shot, finished install" tone="light" class="wide" />
      <ImageSlot label="Survey / measuring up" tone="light" class="small" />
      <ImageSlot label="Fitting in progress" tone="light" class="small" />
    </div>
  </div>
</section>

<style>
  .process {
    background: var(--chalk);
    border-top: 1px solid var(--line);
  }

  .grid {
    padding-block: var(--section-pad);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  h2 {
    font-size: clamp(28px, 3.9vw, 46px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 20ch;
    text-wrap: pretty;
  }

  .copy > p {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 50ch;
  }

  .steps {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .steps li {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }

  .steps li:last-child {
    border-bottom: 0;
  }

  .num {
    flex: none;
    width: 64px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 3.6vw, 48px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--sand-deep);
    margin-top: -4px;
  }

  h3 {
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .steps p {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 46ch;
  }

  .cta {
    margin-top: 8px;
  }

  .photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    border-left: 1px solid var(--line);
    padding-left: clamp(20px, 3vw, 44px);
  }

  .photos :global(.wide) {
    grid-column: 1 / -1;
    width: 100%;
    aspect-ratio: 3 / 2;
  }

  .photos :global(.small) {
    width: 100%;
    aspect-ratio: 4 / 3;
  }
</style>
