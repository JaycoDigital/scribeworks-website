---
import ArrowIcon from './ArrowIcon.astro';

const faqs = [
  { q: 'Do you charge for a survey or a quote?', a: 'No. The survey and the written quote are both free, and there is no deposit to book the survey. We only ask for a deposit once you have accepted a fixed price in writing.' },
  { q: 'How long does a typical window job take?', a: 'Most houses are done in two to three days once the frames have been made. Bi-folds and structural openings take longer, and the dates are in the quote before you commit.' },
  { q: 'Do you handle building regulations and FENSA?', a: 'Yes. Windows and doors are registered with FENSA and you get the certificate on completion. For extensions and structural work we deal with building control and the inspections for you.' },
  { q: 'Which areas do you cover?', a: 'Bognor Regis, Chichester, Littlehampton, Arundel, Worthing and the villages in between, plus east Hampshire on larger projects.' },
  { q: 'What does the guarantee actually cover?', a: 'Ten years on our workmanship, plus the manufacturer guarantee on frames and glass units. If something is not right we come back and put it right. Same crew, no call-out charge.' },
];
---

<section id="faq" class="faq">
  <div class="container grid">
    <div class="copy" data-reveal-stagger>
      <h2>Frequently asked questions</h2>
      <p>Can't find what you're looking for? Send our friendly team a message and we'll be happy to help.</p>
      <div class="cta">
        <a href="#contact" class="btn btn--slate">Contact us<ArrowIcon size={14} /></a>
      </div>
    </div>

    <div class="list" data-reveal-stagger>
      {
        faqs.map((f, i) => (
          <details class="item" open={i === 0}>
            <summary>
              <span>{f.q}</span>
              <span class="sign" aria-hidden="true"></span>
            </summary>
            <div class="answer">{f.a}</div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--chalk);
    border-top: 1px solid var(--line);
  }

  .grid {
    padding-block: var(--section-pad);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(36px, 5vw, 64px);
    align-items: start;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h2 {
    font-size: clamp(34px, 4.2vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 20ch;
    text-wrap: pretty;
  }

  .copy > p {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 46ch;
  }

  .cta {
    margin-top: 8px;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .item {
    border: 1px solid var(--line);
    background: var(--white);
  }

  summary {
    list-style: none;
    padding: 24px 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .sign {
    position: relative;
    width: 14px;
    height: 14px;
    flex: none;
  }

  .sign::before,
  .sign::after {
    content: '';
    position: absolute;
    background: var(--sand-deep);
    inset: 6px 0;
  }

  .sign::after {
    inset: 0 6px;
    transition: transform var(--ease);
  }

  .item.is-open .sign::after {
    transform: scaleY(0);
  }

  .sign::before,
  .sign::after {
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .answer {
    padding: 0 26px 26px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 62ch;
    overflow: hidden;
  }
</style>

<script>
  // Animate <details> open/close (native toggling is instant) and keep the
  // accordion exclusive so only one answer is open at a time.
  const DURATION = 320;
  const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = [...document.querySelectorAll<HTMLDetailsElement>('#faq .item')];
  const busy = new WeakSet<HTMLDetailsElement>();

  const close = (item: HTMLDetailsElement) => {
    const body = item.querySelector<HTMLElement>('.answer');
    if (!body || !item.open || busy.has(item)) return;
    busy.add(item);
    item.classList.remove('is-open');
    const anim = body.animate(
      [{ height: `${body.offsetHeight}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
      { duration: reduce ? 0 : DURATION, easing: EASE },
    );
    anim.onfinish = () => {
      item.open = false;
      busy.delete(item);
    };
  };

  const open = (item: HTMLDetailsElement) => {
    const body = item.querySelector<HTMLElement>('.answer');
    if (!body || item.open || busy.has(item)) return;
    busy.add(item);
    item.open = true;
    item.classList.add('is-open');
    const anim = body.animate(
      [{ height: '0px', opacity: 0 }, { height: `${body.offsetHeight}px`, opacity: 1 }],
      { duration: reduce ? 0 : DURATION, easing: EASE },
    );
    anim.onfinish = () => busy.delete(item);
  };

  items.forEach((item) => {
    if (item.open) item.classList.add('is-open');
    item.querySelector('summary')?.addEventListener('click', (e) => {
      e.preventDefault();
      if (item.open) {
        close(item);
      } else {
        items.forEach((other) => other !== item && close(other));
        open(item);
      }
    });
  });
</script>
