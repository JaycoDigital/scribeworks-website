---
import ImageSlot from './ImageSlot.astro';
import ArrowIcon from './ArrowIcon.astro';
import PhoneIcon from './PhoneIcon.astro';
---

<section id="contact" class="contact">
  <ImageSlot label="Wide interior photo — doors open onto garden" class="photo" />
  <div class="scrim"></div>

  <div class="container grid">
    <div class="copy">
      <h2>Tell us what you need doing</h2>
      <p>We'll measure up at a time that suits and put a fixed price in writing. No deposit to book, no obligation after.</p>
      <div class="phone">
        <span class="phone-icon"><PhoneIcon size={24} stroke="var(--ink)" /></span>
        <div>
          <div class="hours">Office, Mon–Fri 7.30am–5pm</div>
          <a href="tel:01243000000" class="number">01243 000 000</a>
        </div>
      </div>
      <p class="areas">Covering Bognor Regis, Chichester, Littlehampton, Arundel and Worthing.</p>
    </div>

    <form class="form" method="post" action="#contact" novalidate>
      <div>
        <h3>Get in touch</h3>
        <p>Fill this in and we'll call you back the same working day.</p>
      </div>
      <div class="row">
        <label><span>Your name</span><input type="text" name="name" placeholder="Jane Hartley" autocomplete="name" required /></label>
        <label><span>Phone</span><input type="tel" name="phone" placeholder="07700 900000" autocomplete="tel" required /></label>
      </div>
      <label><span>Postcode</span><input type="text" name="postcode" placeholder="PO21" autocomplete="postal-code" /></label>
      <label>
        <span>What do you need?</span>
        <select name="service">
          <option>Windows</option>
          <option>Doors</option>
          <option>Cladding</option>
          <option>Building works</option>
          <option>Not sure yet</option>
        </select>
      </label>
      <label><span>Anything we should know?</span><textarea name="notes" rows="3" placeholder="Rough number of windows, when you'd like it done…"></textarea></label>
      <button type="submit" class="btn btn--graphite submit">Request my free survey<ArrowIcon /></button>
      <p class="fine">We'll only use your details to arrange the survey. No mailing lists, no third parties.</p>
    </form>
  </div>
</section>

<style>
  .contact {
    position: relative;
    background: var(--ink);
    overflow: hidden;
  }

  .contact :global(.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(29, 29, 29, 0.92) 0%, rgba(29, 29, 29, 0.72) 45%, rgba(29, 29, 29, 0.35) 100%);
  }

  .grid {
    position: relative;
    padding-block: clamp(64px, 8vw, 110px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(36px, 5vw, 64px);
    align-items: center;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
    color: var(--chalk);
    border-left: 2px solid var(--sand);
    padding-left: clamp(20px, 3vw, 40px);
  }

  h2 {
    font-size: clamp(30px, 4.2vw, 50px);
    line-height: 1.03;
    letter-spacing: -0.03em;
    max-width: 20ch;
    text-wrap: pretty;
  }

  .copy > p {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: rgba(250, 249, 246, 0.86);
    max-width: 46ch;
  }

  .phone {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 8px;
  }

  .phone-icon {
    width: 56px;
    height: 56px;
    background: var(--sand);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .hours {
    font-size: 14px;
    color: rgba(250, 249, 246, 0.76);
  }

  .number {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -0.02em;
    color: var(--chalk);
    display: block;
    margin-top: 4px;
  }

  .number:hover {
    color: var(--sand);
  }

  .areas {
    font-size: 15px !important;
    color: rgba(250, 249, 246, 0.7) !important;
    max-width: 40ch !important;
    margin-top: 6px !important;
  }

  .form {
    background: var(--chalk);
    color: var(--ink);
    padding: clamp(28px, 3.6vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h3 {
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-bottom: 10px;
  }

  .form > div > p {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
  }

  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 16px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label > span {
    font-size: 14px;
    font-weight: 600;
  }

  input,
  select,
  textarea {
    font-family: var(--font-body);
    font-size: 16px;
    padding: 14px 15px;
    border: 1.5px solid var(--line);
    border-radius: 0;
    background: var(--white);
    color: var(--ink);
    outline: none;
    width: 100%;
    transition: border-color var(--ease);
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--slate);
  }

  .submit {
    justify-content: center;
    padding: 17px 26px;
  }

  .fine {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
