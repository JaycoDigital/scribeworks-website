---
/**
 * Brand line icons, drawn on a 48px grid: single 1.6px stroke, square-cut
 * ends, mitred joins, no fills (see docs/brand-guidelines.md → Iconography).
 */
interface Props {
  name: keyof typeof icons;
  size?: number;
  stroke?: string;
  class?: string;
}

const icons = {
  // Shield with a tick — workmanship guarantee
  guarantee: [
    'M24 5L40 11v13c0 10-7 17.5-16 20C15 41.5 8 34 8 24V11z',
    'M16.5 24.5l5.5 5.5 10-11',
  ],
  // Certificate with a seal and ribbon — registered / certified
  certificate: [
    'M9 6h30v29H32.5',
    'M9 6v29h14.5',
    'M15 14h18',
    'M15 20h18',
    'M15 26h9',
    'M28 31.5a4 4 0 108 0 4 4 0 10-8 0z',
    'M29 35v8l3-2.4 3 2.4v-8',
  ],
  // Tape measure — free survey
  survey: [
    'M7 24a12 12 0 1024 0 12 12 0 10-24 0z',
    'M15 24a4 4 0 108 0 4 4 0 10-8 0z',
    'M31 21h13v7H31',
    'M35 21v3M39 21v4',
    'M9 30l-4 8h11',
  ],
  // Tick in a square frame — list checks
  check: [
    'M6 6h36v36H6z',
    'M14 24.5l7 7 13-15',
  ],
  // Bare tick
  tick: [
    'M9 25l10 10 20-22',
  ],
  // Price tag — fixed price
  price: [
    'M26 6h16v16L22 42 6 26z',
    'M34 12a2 2 0 100 .1z',
    'M18 24l6 6',
  ],
};

const { name, size = 22, stroke = 'currentColor', class: className } = Astro.props;
const paths = icons[name];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke={stroke}
  stroke-width="1.6"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
>
  {paths.map((d) => <path d={d} />)}
</svg>
