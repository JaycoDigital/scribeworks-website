---
import { Image } from 'astro:assets';
import Header from './Header.astro';
import ArrowIcon from './ArrowIcon.astro';
import Icon from './Icon.astro';
import heroPhoto from '../../assets/hero-house.jpg';

const points = [
  { icon: 'guarantee', text: '10-year workmanship guarantee' },
  { icon: 'certificate', text: 'FENSA registered installer' },
] as const;
---

<section class="hero">
  <Image
    src={heroPhoto}
    alt=""
    class="hero-photo"
    width={2200}
    widths={[800, 1200, 1600, 2200]}
    sizes="100vw"
    format="webp"
    quality={78}
    loading="eager"
    fetchpriority="high"
  />
  <div class="scrim"></div>

  <Header />

  <div class="body">
    <div class="container inner">
      <div class="copy">
        <h1>Windows, Doors &amp; Cladding in Bognor&nbsp;Regis</h1>
        <p>Beautifully fitted, built to last and designed around your home, with over 10 years' experience behind every job. Book your free survey and no-obligation quote today.</p>
        <ul class="points">
          {
            points.map((p) => (
              <li>
                <Icon name={p.icon} size={26} stroke="var(--sand)" />
                <span>{p.text}</span>
              </li>
            ))
          }
        </ul>
        <div class="actions">
          <a href="#contact" class="btn btn--slate">Book a free survey<ArrowIcon /></a>
        </div>
        <div class="rating" role="img" aria-label="Rated 4.8 out of 5">
          <span class="rating-num">4.8</span>
          <span class="rating-stars" style="--fill: 96%" aria-hidden="true">
            <span class="rating-stars-bg">★★★★★</span>
            <span class="rating-stars-fg">★★★★★</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--ink);
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  .hero :global(.hero-photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 50%;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(29, 29, 29, 0.9) 0%,
      rgba(29, 29, 29, 0.66) 42%,
      rgba(29, 29, 29, 0.18) 78%,
      rgba(29, 29, 29, 0.1) 100%
    );
  }

  .rating {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    align-self: flex-start;
    margin-top: 4px;
    color: var(--chalk);
    font-size: 14px;
    line-height: 1;
  }

  .rating-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.02em;
  }

  .rating-stars {
    position: relative;
    display: inline-block;
    font-size: 15px;
    letter-spacing: 2px;
    line-height: 1;
  }

  .rating-stars-bg {
    color: rgba(250, 249, 246, 0.25);
  }

  .rating-stars-fg {
    position: absolute;
    inset: 0;
    width: var(--fill, 100%);
    overflow: hidden;
    white-space: nowrap;
    color: var(--sand);
  }


  /* Narrow screens: the copy sits over the house, so tint evenly */
  @media (max-width: 760px) {
    .scrim {
      background: linear-gradient(to bottom, rgba(29, 29, 29, 0.72) 0%, rgba(29, 29, 29, 0.84) 60%, rgba(29, 29, 29, 0.9) 100%);
    }
  }


  .body {
    position: relative;
    z-index: 20;
    flex: 1;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .inner {
    width: 100%;
    padding-block: clamp(56px, 8vw, 96px);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 26px;
    max-width: 700px;
    color: var(--chalk);
  }

  h1 {
    font-size: clamp(38px, 6.4vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }

  .copy > p {
    margin: 0;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.7;
    color: rgba(250, 249, 246, 0.86);
    max-width: 52ch;
  }

  .points {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 44px);
  }

  .points li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
  }

  .points svg {
    flex: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin-top: 12px;
  }

</style>
