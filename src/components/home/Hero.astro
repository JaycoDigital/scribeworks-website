---
import Header from './Header.astro';
import ImageSlot from './ImageSlot.astro';
import ArrowIcon from './ArrowIcon.astro';

const points = ['10-year workmanship guarantee', 'FENSA registered installer'];
---

<section class="hero">
  <ImageSlot label="Hero photo — bright room, wide window or door set, shot from inside" class="hero-photo" />
  <div class="scrim"></div>
  <div class="container rules" aria-hidden="true">
    <div></div><div></div><div></div><div></div>
  </div>

  <Header />

  <div class="body">
    <div class="container inner">
      <div class="copy">
        <h1>Windows and doors, fitted like they're ours</h1>
        <p>Free survey, a fixed price in writing and a crew that clears up. Windows, doors, cladding and full building works across the south coast.</p>
        <ul class="points">
          {
            points.map((p) => (
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--sand)" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                  <rect x="2.5" y="2.5" width="19" height="19" />
                  <path d="M6.5 12.5l3.5 3.5 7-7" />
                </svg>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
        <div class="actions">
          <a href="#contact" class="btn btn--slate">Book a free survey<ArrowIcon /></a>
          <a href="#film" class="play">
            <span class="play-btn" aria-hidden="true">
              <svg width="14" height="16" viewBox="0 0 14 16" fill="var(--ink)"><path d="M0 0l14 8-14 8z" /></svg>
            </span>
            <span>Watch a fit-out</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--ink);
    min-height: min(94vh, 860px);
    display: flex;
    flex-direction: column;
  }

  .hero :global(.hero-photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(29, 29, 29, 0.9) 0%,
      rgba(29, 29, 29, 0.66) 42%,
      rgba(29, 29, 29, 0.18) 78%,
      rgba(29, 29, 29, 0.1) 100%
    );
  }

  .rules {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    pointer-events: none;
  }

  .rules div {
    border-right: 1px solid var(--chalk-14);
  }

  .rules div:first-child {
    border-left: 1px solid var(--chalk-14);
  }

  .body {
    position: relative;
    z-index: 20;
    flex: 1;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .inner {
    width: 100%;
    padding-block: clamp(56px, 8vw, 96px);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 26px;
    max-width: 700px;
    color: var(--chalk);
    border-left: 2px solid var(--sand);
    padding-left: clamp(20px, 3vw, 40px);
  }

  h1 {
    font-size: clamp(38px, 6.4vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }

  .copy > p {
    margin: 0;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.7;
    color: rgba(250, 249, 246, 0.86);
    max-width: 52ch;
  }

  .points {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 44px);
  }

  .points li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
  }

  .points svg {
    flex: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin-top: 12px;
  }

  .play {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--chalk);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .play:hover {
    color: var(--sand);
  }

  .play-btn {
    width: 52px;
    height: 52px;
    background: var(--chalk);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    transition: background var(--ease);
  }

  .play:hover .play-btn {
    background: var(--sand);
  }
</style>
