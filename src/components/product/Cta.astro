---
import ArrowIcon from '../home/ArrowIcon.astro';
import PhoneIcon from '../home/PhoneIcon.astro';
import Icon from '../home/Icon.astro';

interface Props {
  heading: string;
  body: string;
  points?: string[];
}

const { heading, body, points = [] } = Astro.props;
---

<section class="cta">
  <div class="container inner" data-reveal-stagger>
    <div class="copy">
      <h2>{heading}</h2>
      <p>{body}</p>
      {
        points.length > 0 && (
          <ul class="points">
            {points.map((p) => (
              <li>
                <Icon name="tick" size={18} stroke="var(--sand)" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="actions">
      <a href="#contact" class="btn btn--sand">Book a free survey<ArrowIcon size={14} /></a>
      <a href="tel:01243000000" class="phone">
        <span class="phone-icon"><PhoneIcon size={20} stroke="var(--ink)" /></span>
        <span>
          <span class="phone-label">Or call the office</span>
          <span class="phone-num">01243 000 000</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--ink);
    color: var(--chalk);
  }

  .inner {
    padding-block: var(--section-pad);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h2 {
    font-size: clamp(32px, 4.2vw, 50px);
    line-height: 1.03;
    letter-spacing: -0.03em;
    max-width: 18ch;
    text-wrap: pretty;
  }

  .copy p {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: rgba(250, 249, 246, 0.82);
    max-width: 48ch;
  }

  .points {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }

  .points li {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 15px;
    font-weight: 500;
  }

  .points :global(svg) {
    flex: none;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  /* Sand button: the guide's accent style, for use on dark sections */
  .actions :global(.btn--sand) {
    background: var(--sand);
    border-color: var(--sand);
    color: var(--ink);
  }

  .actions :global(.btn--sand:hover),
  .actions :global(.btn--sand:focus-visible) {
    background: #d3c795;
    border-color: #d3c795;
    color: var(--ink);
  }

  .phone {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--chalk);
  }

  .phone:hover {
    color: var(--chalk);
  }

  .phone-icon {
    width: 52px;
    height: 52px;
    background: var(--sand);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .phone-label {
    display: block;
    font-size: 14px;
    color: rgba(250, 249, 246, 0.72);
  }

  .phone-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.02em;
    margin-top: 2px;
  }

  .phone:hover .phone-num {
    color: var(--sand);
  }
</style>
