---
/**
 * Reasons to use us: a pair of photos with a row of short, icon-led points
 * underneath.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../home/Icon.astro';

interface Item {
  icon: 'survey' | 'window' | 'energy' | 'lock' | 'certificate' | 'guarantee' | 'check' | 'price';
  title: string;
  body: string;
}

interface Props {
  heading: string;
  intro?: string;
  items: Item[];
  photoA: ImageMetadata;
  altA?: string;
  photoB: ImageMetadata;
  altB?: string;
}

const { heading, intro, items, photoA, altA = '', photoB, altB = '' } = Astro.props;
---

<section id="why" class="benefits">
  <div class="container inner">
    <div class="section-head" data-reveal-stagger>
      <h2>{heading}</h2>
      {intro && <p>{intro}</p>}
    </div>

    <div class="photos" data-reveal-stagger>
      <div class="shot">
        <Image src={photoA} alt={altA} class="photo" widths={[700, 1000, 1500]} sizes="(max-width: 760px) 100vw, 55vw" format="webp" quality={80} />
      </div>
      <div class="shot">
        <Image src={photoB} alt={altB} class="photo" widths={[500, 800, 1100]} sizes="(max-width: 760px) 100vw, 38vw" format="webp" quality={80} />
      </div>
    </div>

    <ul class="grid" data-reveal-stagger>
      {
        items.map((item) => (
          <li class="item">
            <p class="head">
              <Icon name={item.icon} size={22} stroke="var(--sand-deep)" />
              <span>{item.title}</span>
            </p>
            <p class="body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .benefits {
    background: var(--chalk);
  }

  .inner {
    padding-block: var(--section-pad);
  }

  .photos {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: clamp(14px, 1.6vw, 22px);
    margin-bottom: clamp(36px, 4vw, 56px);
  }

  .shot {
    position: relative;
    height: clamp(260px, 32vw, 460px);
    overflow: hidden;
    background: var(--line);
  }

  .shot :global(.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Ruled grid: the cells are divided by hairlines rather than plain gaps.
     The negative margin pulls the outer cells' padding back off the
     container, so the copy still lines up with the photos above. */
  .grid {
    --cell-pad: clamp(20px, 2.2vw, 36px);
    --row-pad: clamp(26px, 3vw, 40px);
    list-style: none;
    margin: 0 calc(var(--cell-pad) * -1);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .item {
    padding: var(--row-pad) var(--cell-pad);
    border-left: 1px solid var(--line);
    border-top: 1px solid var(--line);
  }

  /* No rule down the outside edge, none above the top row */
  .item:nth-child(3n + 1) {
    border-left: 0;
  }

  .item:nth-child(-n + 3) {
    border-top: 0;
    padding-top: 0;
  }

  .head {
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .head :global(svg) {
    flex: none;
  }

  /* Description lines up under the title, clear of the icon */
  .body {
    margin: 0;
    padding-left: 34px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
    max-width: 38ch;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Put back what the three-column rules took away, then redraw for two */
    .item:nth-child(3n + 1) {
      border-left: 1px solid var(--line);
    }

    .item:nth-child(-n + 3) {
      border-top: 1px solid var(--line);
      padding-top: var(--row-pad);
    }

    .item:nth-child(2n + 1) {
      border-left: 0;
    }

    .item:nth-child(-n + 2) {
      border-top: 0;
      padding-top: 0;
    }
  }

  @media (max-width: 760px) {
    .photos {
      grid-template-columns: 1fr;
    }

    .shot {
      height: auto;
      aspect-ratio: 4 / 3;
      align-self: start;
    }

    /* Same as the style cards: give the box real height for Safari */
    .shot::before {
      content: '';
      display: block;
      padding-top: 75%;
    }

    .grid {
      grid-template-columns: 1fr;
      margin-inline: 0;
      --cell-pad: 0px;
    }

    /* Stacked: one rule between each pair of points */
    .item:nth-child(-n + 2) {
      border-top: 1px solid var(--line);
      padding-top: var(--row-pad);
    }

    .item:nth-child(n) {
      border-left: 0;
    }

    .item:first-child {
      border-top: 0;
      padding-top: 0;
    }
  }
</style>
