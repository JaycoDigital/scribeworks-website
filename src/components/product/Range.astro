---
/**
 * One product range: a full-bleed photo filling half the page, copy alongside.
 * Pass `flip` to mirror it so a list of these alternates down the page.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ImageSlot from '../home/ImageSlot.astro';
import Icon from '../home/Icon.astro';

interface Props {
  brand: string;
  logo?: ImageMetadata;
  title: string;
  body: string;
  points: string[];
  bestFor?: string;
  photo?: ImageMetadata;
  photoLabel: string;
  alt?: string;
  flip?: boolean;
  tone?: 'chalk' | 'white';
}

const { brand, logo, title, body, points, bestFor, photo, photoLabel, alt = '', flip = false, tone = 'chalk' } = Astro.props;
---

<section class:list={['range', `range--${tone}`, { 'is-flipped': flip }]}>
  <div class="media" data-reveal>
    {
      photo ? (
        <Image src={photo} alt={alt} class="photo" widths={[700, 1000, 1500]} sizes="(max-width: 860px) 100vw, 52vw" format="webp" quality={80} />
      ) : (
        <ImageSlot label={photoLabel} tone="light" class="photo" />
      )
    }
  </div>

  <div class="copy">
    <div class="copy-inner" data-reveal-stagger>
      {
        logo ? (
          <Image src={logo} alt={brand} class="logo" widths={[200, 400]} sizes="170px" />
        ) : (
          <p class="eyebrow brand">{brand}</p>
        )
      }
      <h3>{title}</h3>
      <p class="body">{body}</p>
      <ul class="points">
        {
          points.map((p) => (
            <li>
              <Icon name="tick" size={18} stroke="var(--sand-deep)" />
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
      {
        bestFor && (
          <p class="best">
            <span class="eyebrow">Best for</span>
            {bestFor}
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .range {
    display: grid;
    grid-template-columns: 52fr 48fr;
    align-items: stretch;
    min-height: clamp(460px, 48vw, 680px);
  }

  .range--chalk {
    background: var(--chalk);
  }

  .range--white {
    background: var(--white);
  }

  /* Photo first in the source so it leads on phones; on wide screens the
     unflipped rows put it on the right */
  .media {
    position: relative;
    overflow: hidden;
    grid-row: 1;
    grid-column: 1;
  }

  .range:not(.is-flipped) .media {
    grid-column: 2;
  }

  .media :global(.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .copy {
    grid-row: 1;
    grid-column: 2;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  /* Unflipped: copy on the left, hugging the middle of the page */
  .range:not(.is-flipped) .copy {
    grid-column: 1;
    justify-content: flex-end;
  }

  .copy-inner {
    max-width: 570px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-block: clamp(48px, 6vw, 88px);
    padding-inline: clamp(24px, 4.5vw, 72px);
  }

  .copy-inner :global(.logo) {
    width: auto;
    height: 30px;
    max-width: 170px;
    object-fit: contain;
    object-position: left center;
  }

  .brand {
    margin: 0;
    color: var(--sand-deep);
  }

  h3 {
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 18ch;
    text-wrap: pretty;
  }

  .body {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 52ch;
  }

  .points {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .points li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 16px;
    line-height: 1.6;
  }

  .points :global(svg) {
    flex: none;
    margin-top: 4px;
  }

  .best {
    margin: 6px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 46ch;
  }

  .best .eyebrow {
    display: block;
    color: var(--sand-deep);
    margin-bottom: 6px;
  }

  /* Stacked: photo above the copy, running edge to edge */
  @media (max-width: 860px) {
    .range,
    .range:not(.is-flipped) {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .media,
    .range:not(.is-flipped) .media {
      grid-row: 1;
      grid-column: 1;
    }

    .copy,
    .range:not(.is-flipped) .copy {
      grid-row: 2;
      grid-column: 1;
    }

    .media {
      aspect-ratio: 4 / 3;
    }

    .copy,
    .range:not(.is-flipped) .copy {
      justify-content: flex-start;
    }

    .copy-inner {
      max-width: none;
      padding-inline: var(--gutter);
      padding-block: clamp(36px, 8vw, 56px);
    }
  }
</style>
