---
/**
 * One window style: a large photo running to the page edge, copy alongside.
 * Pass `flip` to mirror it so a list of these alternates down the page.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ImageSlot from '../home/ImageSlot.astro';
import Icon from '../home/Icon.astro';

interface Props {
  brand: string;
  logo?: ImageMetadata;
  title: string;
  body: string;
  points: string[];
  bestFor?: string;
  photo?: ImageMetadata;
  photoLabel: string;
  alt?: string;
  flip?: boolean;
}

const { brand, logo, title, body, points, bestFor, photo, photoLabel, alt = '', flip = false } = Astro.props;
---

<section class:list={['range', { 'is-flipped': flip }]}>
  <div class="inner">
    <div class="media" data-reveal>
      {
        photo ? (
          <Image src={photo} alt={alt} class="photo" widths={[700, 1000, 1500]} sizes="(max-width: 860px) 100vw, 56vw" format="webp" quality={80} />
        ) : (
          <ImageSlot label={photoLabel} tone="light" class="photo" />
        )
      }
    </div>

    <div class="copy" data-reveal-stagger>
      <h3>{title}</h3>
      <p class="body">{body}</p>
      <ul class="points">
        {
          points.map((p) => (
            <li>
              <Icon name="tick" size={18} stroke="var(--sand-deep)" />
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
      <div class="foot">
        {
          bestFor && (
            <p class="best">
              <span class="eyebrow">Best for</span>
              {bestFor}
            </p>
          )
        }
        {
          logo && (
            <p class="supplier">
              <span class="eyebrow">Supplied by</span>
              <Image src={logo} alt={brand} class="logo" widths={[200, 400]} sizes="130px" />
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .range {
    background: var(--chalk);
    padding-block: clamp(40px, 5vw, 72px);
    overflow-x: clip;
  }

  .inner {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  /* Mirrored rows: the wide column moves to the left so the photo stays the
     same size either way */
  .is-flipped .inner {
    grid-template-columns: 1.25fr 1fr;
  }

  /* Photo first in the source so it leads on phones; on wide screens it takes
     the right-hand column and runs off the edge of the page */
  .media {
    grid-row: 1;
    grid-column: 2;
    aspect-ratio: 4 / 3;
    position: relative;
    overflow: hidden;
    margin-right: calc(-1 * (var(--gutter) + max(0px, 50vw - 640px)));
  }

  .is-flipped .media {
    grid-column: 1;
    margin-right: 0;
    margin-left: calc(-1 * (var(--gutter) + max(0px, 50vw - 640px)));
  }

  .media :global(.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .copy {
    grid-row: 1;
    grid-column: 1;
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 520px;
  }

  .is-flipped .copy {
    grid-column: 2;
  }

  h3 {
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    max-width: 16ch;
    text-wrap: pretty;
  }

  .body {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
  }

  .points {
    list-style: none;
    margin: 2px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .points li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 16px;
    line-height: 1.6;
  }

  .points :global(svg) {
    flex: none;
    margin-top: 4px;
  }

  .foot {
    margin-top: 8px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 32px;
  }

  .best {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 34ch;
  }

  .eyebrow {
    display: block;
    color: var(--sand-deep);
    margin-bottom: 6px;
  }

  /* The maker is supporting information, not the headline */
  .supplier {
    margin: 0;
  }

  .supplier .eyebrow {
    color: var(--muted);
    margin-bottom: 8px;
  }

  .supplier :global(.logo) {
    width: auto;
    height: 22px;
    max-width: 130px;
    object-fit: contain;
    object-position: left center;
    opacity: 0.55;
  }

  /* Stacked: photo above the copy, running edge to edge */
  @media (max-width: 860px) {
    .range {
      padding-block: 0 clamp(48px, 9vw, 72px);
    }

    .inner,
    .is-flipped .inner {
      grid-template-columns: 1fr;
      gap: clamp(28px, 6vw, 40px);
      padding-inline: 0;
    }

    .media,
    .is-flipped .media {
      grid-row: 1;
      grid-column: 1;
      margin-inline: 0;
    }

    .copy,
    .is-flipped .copy {
      grid-row: 2;
      grid-column: 1;
      max-width: none;
      padding-inline: var(--gutter);
    }
  }
</style>
