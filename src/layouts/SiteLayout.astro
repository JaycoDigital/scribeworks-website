---
/**
 * Shared shell for the site's pages: preview gate, smooth scrolling and
 * scroll-triggered entrances.
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <script is:inline slot="head">
    // Preview gate: only reachable after entering the password on the landing page
    try {
      if (localStorage.getItem('sw-preview') !== '4818bcac2aa71683f578db3f81f433743f73a970fe77e845835d8d68da3e5eb0') location.replace('/');
    } catch (e) {
      location.replace('/');
    }
  </script>

  <slot />
</BaseLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>

<script>
  // Fade-up entrances: [data-reveal] on single elements, [data-reveal-stagger]
  // on a parent to reveal its children one after another.
  const STEP = 90;
  const targets = new Set<Element>(document.querySelectorAll('[data-reveal]'));
  document.querySelectorAll('[data-reveal-stagger]').forEach((group) => {
    [...group.children].forEach((child, i) => {
      (child as HTMLElement).style.setProperty('--reveal-delay', `${i * STEP}ms`);
      targets.add(child);
    });
  });

  const MARGIN = 40; // reveal a little before the element reaches the fold
  const show = (el: Element) => {
    el.classList.add('is-in');
    targets.delete(el);
    io.unobserve(el);
  };

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) show(e.target);
    },
    { threshold: 0.05, rootMargin: `0px 0px -${MARGIN}px 0px` },
  );
  targets.forEach((t) => io.observe(t));

  // Belt and braces: the observer's first callback is not always delivered,
  // which would leave anything already on screen stuck invisible. Sweep the
  // viewport ourselves on load and while scrolling.
  let queued = false;
  const sweep = () => {
    queued = false;
    const limit = window.innerHeight - MARGIN;
    for (const el of [...targets]) {
      // Anything at or above the fold, including elements a fast scroll has
      // already carried past, which the observer can miss entirely
      if (el.getBoundingClientRect().top < limit) show(el);
    }
  };
  const queue = () => {
    if (queued || targets.size === 0) return;
    queued = true;
    requestAnimationFrame(sweep);
  };

  queue();
  window.addEventListener('load', queue);
  window.addEventListener('scroll', queue, { passive: true });
  window.addEventListener('resize', queue, { passive: true });
</script>
