---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductHero from '../components/product/ProductHero.astro';
import Benefits from '../components/product/Benefits.astro';
import StyleCards from '../components/product/StyleCards.astro';
import OtherServices from '../components/product/OtherServices.astro';
import Footer from '../components/home/Footer.astro';

import heroPhoto from '../assets/product-doors.jpg';
import endurance from '../assets/logo-endurance-ink.png';
import rockdoor from '../assets/logo-rockdoor-ink.png';
import photoFitting from '../assets/doors-fitting.png';
import photoChoosing from '../assets/doors-choosing.jpg';
import photoComposite from '../assets/door-composite.jpg';
import photoFrench from '../assets/door-french.jpg';
import photoFlush from '../assets/door-flush.jpg';
import photoSingle from '../assets/door-single.jpg';
import photoStable from '../assets/door-stable.jpg';

const benefits = [
  {
    icon: 'survey',
    title: 'Free, no-obligation survey',
    body: 'We measure your opening at your home and follow with an itemised quote within three working days.',
  },
  {
    icon: 'window',
    title: 'Made to measure',
    body: 'Your door is built to your own opening, so it hangs true and closes sweetly from the first day.',
  },
  {
    icon: 'lock',
    title: 'Security you can feel',
    body: 'Solid cores, multipoint locking and cylinders that resist snapping, fitted properly into a solid frame.',
  },
  {
    icon: 'energy',
    title: 'Warm and draught-free',
    body: 'Insulated cores and proper weather seals keep the hallway warm and the weather where it belongs.',
  },
  {
    icon: 'certificate',
    title: 'Paperwork taken care of',
    body: 'Registered with FENSA, with your certificate issued on completion of the work.',
  },
  {
    icon: 'guarantee',
    title: 'Guaranteed for ten years',
    body: 'Our workmanship is guaranteed for a decade, alongside the manufacturer guarantees on your door.',
  },
] as const;

const styles = [
  {
    brand: 'Endurance',
    logo: endurance,
    title: 'Composite doors',
    body: 'The door most people picture when they think of a new front door. A thick, solid core gives it real weight and a reassuring sound when it closes, with a timber-look finish that never needs painting.',
    points: [
      'Solid core with genuine weight and feel',
      'Timber character without the upkeep',
      'A wide choice of colours and furniture',
      'Warm underfoot and draught-free',
    ],
    bestFor: 'Any home wanting a warm, solid and handsome front door.',
    photo: photoComposite,
    alt: 'A sage green composite front door in the arched porch of a stone cottage',
    photoLabel: 'Composite front door',
  },
  {
    brand: 'French doors',
    title: 'French doors',
    body: 'A pair of doors that open out into the garden and let the room breathe. They suit almost any house, take up no room inside when they are open and bring a surprising amount of light into the back of a home.',
    points: [
      'Opens wide onto the garden or patio',
      'Plenty of extra daylight into the room',
      'Multipoint locking on both leaves',
      'Side panels available for wider openings',
    ],
    bestFor: 'Dining rooms, kitchens and garden-facing walls.',
    photo: photoFrench,
    alt: 'White French doors in a stone wall, open onto a patio and garden',
    photoLabel: 'French doors onto a garden',
  },
  {
    brand: 'Rockdoor',
    logo: rockdoor,
    title: 'Flush doors',
    body: 'A door that sits flat within its frame rather than standing proud of it, for a clean and unbroken face. The smooth line looks at home on a newer house and leaves far less for the weather, or anyone else, to get hold of.',
    points: [
      'Sits flush in the frame for a clean face',
      'Glass bonded in, with no beading to lever out',
      'Crisp, modern lines inside and out',
      'Reinforced frame and heavy-duty locking',
    ],
    bestFor: 'Newer homes and anyone wanting the most secure option.',
    photo: photoFlush,
    alt: 'A flush fitting graphite front door with slim glazed side panels',
    photoLabel: 'Flush fitting front door',
  },
  {
    brand: 'Endurance',
    logo: endurance,
    title: 'Single doors',
    body: 'The door you actually use every day. Back doors, side doors and utility doors take more of a hammering than the front, so we build them to the same standard, with the same locking and the same finish so everything matches.',
    points: [
      'Built to take daily use and weather',
      'Matching colours and hardware to your front door',
      'Glazed or solid, whichever suits the room',
      'Cat flaps and letterplates fitted neatly',
    ],
    bestFor: 'Kitchens, utilities and side entrances.',
    photo: photoSingle,
    alt: 'A graphite single back door with a glazed top half',
    photoLabel: 'Single back door',
  },
  {
    brand: 'Stable doors',
    title: 'Stable doors',
    body: 'Open the top half and keep the bottom shut. Air and light come in while the dog stays in and the children stay put, then the two halves close together and lock as one solid door.',
    points: [
      'Top and bottom halves that open apart',
      'Locks as one solid door when closed',
      'Fresh air without an open doorway',
      'A natural fit for kitchens and cottages',
    ],
    bestFor: 'Kitchens, country homes and anyone with pets.',
    photo: photoStable,
    alt: 'An oak stable door on a cottage with the top half open',
    photoLabel: 'Stable door with the top half open',
  },
];
---

<SiteLayout
  title="Doors | Composite, French, Flush & Stable Doors in West Sussex | Scribeworks"
  description="Composite, French, flush, single and stable doors, made to measure and fitted by our own team. Free survey, a fixed price in writing and a ten-year guarantee."
>
  <ProductHero
    title="West Sussex Doors"
    intro="Made to measure West Sussex doors, fitted by our own team. The first thing anyone sees, and the last thing you lock at night."
    photo={heroPhoto}
    alt="A newly fitted front door"
  />

  <Benefits
    heading="Doors that welcome you home"
    intro="From the first measurement to the final clean-up, your project stays with the same local team."
    items={benefits}
    photoA={photoFitting}
    altA="A Scribeworks fitter checking a newly hung door for level"
    photoB={photoChoosing}
    altB="A customer trying door handles in a showroom"
  />

  <StyleCards
    heading="Door styles to suit your home"
    intro="From the front door to the doors onto the garden, these are the styles we fit most often. During your survey we will help you find the one that suits your home, your security and your budget."
    styles={styles}
  />

  <OtherServices
    heading="Other services from Scribeworks"
    intro="Doors are only part of what we do. Take a look at the rest of our work around your home."
    exclude="/doors"
  />

  <Footer />
</SiteLayout>
