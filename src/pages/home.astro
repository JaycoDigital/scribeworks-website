---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Film from '../components/home/Film.astro';
import About from '../components/home/About.astro';
import Products from '../components/home/Products.astro';
import Process from '../components/home/Process.astro';
import Reviews from '../components/home/Reviews.astro';
import Faq from '../components/home/Faq.astro';
import Footer from '../components/home/Footer.astro';
---

<BaseLayout
  title="Scribeworks | Windows, Doors, Cladding & Building Works"
  description="Free survey, a fixed price in writing and a crew that clears up. Windows, doors, cladding and full building works across the south coast."
>
  <Hero />
  <About />
  <Film />
  <Products />
  <Process />
  <Reviews />
  <Faq />
  <Footer />
</BaseLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>

<script>
  // Fade-up entrances: [data-reveal] on single elements, [data-reveal-stagger]
  // on a parent to reveal its children one after another.
  const STEP = 90;
  const targets: Element[] = [...document.querySelectorAll('[data-reveal]')];
  document.querySelectorAll('[data-reveal-stagger]').forEach((group) => {
    [...group.children].forEach((child, i) => {
      (child as HTMLElement).style.setProperty('--reveal-delay', `${i * STEP}ms`);
      targets.push(child);
    });
  });

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
  );
  targets.forEach((t) => io.observe(t));
</script>
