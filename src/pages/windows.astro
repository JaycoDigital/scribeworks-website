---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductHero from '../components/product/ProductHero.astro';
import Benefits from '../components/product/Benefits.astro';
import Range from '../components/product/Range.astro';
import OtherServices from '../components/product/OtherServices.astro';
import Footer from '../components/home/Footer.astro';

import heroPhoto from '../assets/product-windows.jpg';
import deceuninck from '../assets/logo-deceuninck-ink.png';
import origin from '../assets/logo-origin-ink.png';
import roseview from '../assets/logo-roseview-ink.png';
import photo2500 from '../assets/window-deceuninck-2500.jpg';
import photo2800 from '../assets/window-deceuninck-2800.png';
import photoFlush from '../assets/window-deceuninck-flush.png';

const benefits = [
  {
    icon: 'survey',
    title: 'A free survey, with no obligation',
    body: 'We will visit your home, take careful measurements and talk you through the possibilities. Your itemised quote follows within three working days.',
  },
  {
    icon: 'window',
    title: 'Made to measure for your home',
    body: 'Every frame is manufactured to your own openings, so the lines are straight, the finish is neat and everything sits exactly as it should.',
  },
  {
    icon: 'energy',
    title: 'Warmer, quieter rooms',
    body: 'Modern glazing makes a wonderful difference to how a room feels. Your home holds its heat for longer, draughts disappear and outside noise softens.',
  },
  {
    icon: 'lock',
    title: 'Peace of mind, built in',
    body: 'Multipoint locking and internally beaded frames come as standard across our ranges, so you can relax knowing your home is well protected.',
  },
  {
    icon: 'certificate',
    title: 'Paperwork taken care of',
    body: 'Your installation is registered with FENSA and your certificate arrives on completion. On larger projects we look after building control too.',
  },
  {
    icon: 'guarantee',
    title: 'Guaranteed for ten years',
    body: 'Our workmanship is guaranteed for a decade, alongside the manufacturer guarantees on your frames and glass. If you need us back, the same team returns.',
  },
] as const;

const ranges = [
  {
    brand: 'Deceuninck',
    logo: deceuninck,
    title: 'Casement windows',
    body: 'The most popular choice, and for good reason. Casement windows open outwards on a hinge, seal tightly when closed and suit almost every style of home. Slim frames let in as much daylight as possible, and there is a colour or woodgrain to match any house.',
    points: [
      'Opens wide for fresh air and easy cleaning',
      'Slim frames that welcome in more light',
      'A wide palette of colours and woodgrain finishes',
      'Warm, draught-free and quiet all year round',
    ],
    bestFor: 'Almost any home, and the natural replacement for tired uPVC.',
    photo: photo2500,
    alt: 'A three-pane white casement window looking out over a garden',
    photoLabel: 'Casement window',
  },
  {
    brand: 'Deceuninck',
    logo: deceuninck,
    title: 'Flush casement windows',
    body: 'All the charm of a traditional timber window, without the upkeep that comes with one. The window closes flush into its frame, just as timber does, giving your home that clean, classic line. A favourite with our customers in period properties.',
    points: [
      'The authentic flush line of a timber window',
      'Timber character with none of the maintenance',
      'Handsome hardware in period finishes',
      'An extensive choice of colours and woodgrains',
    ],
    bestFor: 'Period homes, conservation areas and barn conversions.',
    photo: photoFlush,
    alt: 'A three-pane flush casement window seen from inside',
    photoLabel: 'Flush casement window',
  },
  {
    brand: 'Deceuninck',
    logo: deceuninck,
    title: 'Period and cottage styles',
    body: 'If your home has character worth keeping, the details matter. Georgian bars, leaded glass and shaped heads can all be worked into your new windows, so the finish looks as though it has always been there while everything behind it is thoroughly modern.',
    points: [
      'Georgian bars and leaded glass',
      'Arched and shaped heads for original openings',
      'Cream, heritage and woodgrain finishes',
      'Modern warmth and security behind a traditional face',
    ],
    bestFor: 'Cottages, farmhouses and homes with original detailing.',
    photo: photo2800,
    alt: 'A cottage window with Georgian bars in a bedroom',
    photoLabel: 'Cottage window with Georgian bars',
  },
  {
    brand: 'Roseview',
    logo: roseview,
    title: 'Sliding sash windows',
    body: 'If your home was built with sash windows, it deserves sash windows. Ours were developed from careful surveys of Georgian and Victorian originals, so the proportions and detailing look right from the street, while you enjoy modern warmth, security and easy cleaning.',
    points: [
      'Authentic period proportions and detailing',
      'Run-through horns and a deep bottom rail',
      'Tilts inwards, so cleaning is simple and safe',
      'Widely welcomed in conservation areas',
    ],
    bestFor: 'Georgian, Victorian and Edwardian homes replacing timber sashes.',
    photoLabel: 'Sliding sash window',
  },
  {
    brand: 'Origin',
    logo: origin,
    title: 'Aluminium windows',
    body: 'For something altogether more contemporary. Aluminium is strong enough to carry wonderfully slim frames and much larger panes of glass, so your rooms fill with daylight and the view from them opens right up.',
    points: [
      'Slim frames and generous expanses of glass',
      'A wide choice of colours, inside and out',
      'Strong, light and beautifully finished',
      'Warm and comfortable all year round',
    ],
    bestFor: 'Extensions, renovations and contemporary homes.',
    photoLabel: 'Aluminium window',
  },
];
---

<SiteLayout
  title="Windows | uPVC, Aluminium & Sliding Sash in West Sussex | Scribeworks"
  description="Casement, flush casement, sliding sash and aluminium windows, made to measure and fitted by our own team. Free survey, a fixed price in writing and a ten-year guarantee."
>
  <ProductHero
    title="Beautiful windows, made to measure for your&nbsp;home"
    intro="The right windows change how your rooms feel and how your home looks from the street. Let us help you find yours."
    photo={heroPhoto}
    alt="New windows fitted to a period house"
  />

  <Benefits
    heading="Why homeowners choose Scribeworks"
    intro="From the first measurement to the final clean-up, your project stays with the same local team."
    items={benefits}
  />

  <section class="ranges">
    <div class="container section-head" data-reveal-stagger>
      <h2>Window styles to suit your home</h2>
      <p>Every home is different. These are the styles we fit most often, all made by manufacturers we know and trust. During your survey we will help you find the one that suits your property, your style and your budget.</p>
    </div>

    {
      ranges.map((r, i) => (
        <Range
          brand={r.brand}
          logo={r.logo}
          title={r.title}
          body={r.body}
          points={r.points}
          bestFor={r.bestFor}
          photo={r.photo}
          alt={r.alt}
          photoLabel={r.photoLabel}
          flip={i % 2 === 1}
        />
      ))
    }
  </section>

  <OtherServices
    heading="More ways we can help"
    intro="Windows are only part of what we do. Take a look at the rest of our work around your home."
    exclude="/windows"
  />

  <Footer />
</SiteLayout>

<style>
  .ranges {
    background: var(--chalk);
  }

  .ranges .section-head {
    padding-top: var(--section-pad);
    margin-bottom: clamp(24px, 3vw, 40px);
  }
</style>
